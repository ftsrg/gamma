package traindoorcontrol

import "Interface/Interface.gcd"

@TransitionPriority = order-based
@IncompleteStatechart
statechart CoFiController [
	port ControlActions : provides ControlActions
	port FeedbackDoorState : requires FeedbackDoorState
	port FeedbackPresence : requires FeedbackPresence
	port ExternalCommunication : requires ExternalCommunication
	port OpenTimeout : requires Timeout { invariant OpenTimeout.^timeout:: imply in-state(Main._4) }
] {
	var upMov : boolean := false
	var upAlign : boolean := true
	var upPresence : boolean := false
	
	region Main {
		initial Initial
		state _1
		state _2
		state _3
		state _4
		state _5
	}
	transition from Initial to _1
	transition from _1 to _2 when ExternalCommunication.movement
			[ExternalCommunication.movement::motionState = MotionState::ARRIVING] /
				upMov := true;
	transition from _2 to _3 when ExternalCommunication.alignment
			[ExternalCommunication.alignment::isAligned = false] /
				upAlign := false;
	transition from _3 to _2 when ExternalCommunication.alignment
			[ExternalCommunication.alignment::isAligned = true] /
				upAlign := true;
	transition from _2 to _4 when ExternalCommunication.movement
			[ExternalCommunication.movement::motionState = MotionState::STILL] /
				upMov := false;
				raise ControlActions.controlDoor(ControlAction::OPEN);
	transition from _4 to _1 when OpenTimeout.^timeout /
				raise ControlActions.controlDoor(ControlAction::CLOSE);
	transition from _4 to _5 when FeedbackPresence.feedback
			[FeedbackPresence.feedback::isPresent] /
				upPresence := true;
	transition from _5 to _4 when FeedbackPresence.feedback
			[not FeedbackPresence.feedback::isPresent] /
				upPresence := false;
	transition from _5 to _5 when FeedbackPresence.feedback
			[FeedbackPresence.feedback::isPresent]
	transition from _1 to _5 when FeedbackPresence.feedback
			[FeedbackPresence.feedback::isPresent] /
				upPresence := true;
				raise ControlActions.controlDoor(ControlAction::OPEN);
}
