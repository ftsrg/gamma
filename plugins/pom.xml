    </repository>
    <repository>
      <!-- VIATRA is not part of the release train -->
      <id>viatra</id>
      <layout>p2</layout>
      <url>https://download.eclipse.org/viatra/updates/release/2.9.1</url>
    </repository>
    <repository>
      <!-- VIATRA requires org.eclipse.collections, dropped after 2025-06 -->
      <id>eclipse-2025-06</id>
      <layout>p2</layout>
      <url>https://download.eclipse.org/releases/2025-06</url>
    </repository>
