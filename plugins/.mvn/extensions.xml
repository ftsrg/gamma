<?xml version="1.0" encoding="UTF-8"?>
<!-- Enables Tycho's pomless build: every directory listed as a module in
     pom.xml gets its packaging, artifactId and version derived from its
     MANIFEST.MF, so there are no per-plugin poms to keep in sync. -->
<extensions>
  <extension>
    <groupId>org.eclipse.tycho</groupId>
    <artifactId>tycho-build</artifactId>
    <version>4.0.13</version>
  </extension>
</extensions>
