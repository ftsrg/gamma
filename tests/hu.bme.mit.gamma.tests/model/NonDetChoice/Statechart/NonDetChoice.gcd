package nondetchoice

import "Interfaces/Interfaces.gcd"

statechart NonDetChoice [
	port Execute : requires Execute
] {
	var count : integer
	region main {
		initial Initial
		state A
		state B
		state BB
		state C
	}
	
	transition from Initial to A
	transition from A to B when Execute.^execute
	transition from A to BB when Execute.^execute [count < 10]
	transition from B to C when cycle
	
}