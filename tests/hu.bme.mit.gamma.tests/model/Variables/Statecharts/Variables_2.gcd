package variables

import "Interfaces/Interfaces.gcd"

statechart Variables_2 [
	port VariableExecute : requires VariableExecute
] {
	var myInt : integer := 5
	var localOtherPortInt : integer := 0
	var localPortRecord : ComplexRecord
	region main {
		initial Initial
		state _A
		state _B
		state _C
	}
	
	transition from Initial to _A
	transition from _A to _B when VariableExecute.^execute / ::VariableExecute::portInt := myInt + -84 + ::VariableExecute::portRecord.b.b; ::VariableExecute::portRecord.a := 12.3;
			::VariableExecute::otherPortInt := ::VariableExecute::otherPortInt + 2; localOtherPortInt := ::VariableExecute::otherPortInt;
	transition from _B to _C when VariableExecute.^execute / myInt := ::VariableExecute::portInt + -72; ::VariableExecute::otherPortInt := ::VariableExecute::otherPortInt - -2;
			::VariableExecute::portRecord.b.a := not ::VariableExecute::portRecord.b.a; ::VariableExecute::portRecord.a := ::VariableExecute::portRecord.a + 12.3;
			::VariableExecute::portRecord.b.b := -::VariableExecute::portRecord.b.b; localOtherPortInt := ::VariableExecute::otherPortInt; localPortRecord := ::VariableExecute::portRecord;
}