package variables

import "Interfaces/Interfaces.gcd"

statechart Variables_1 [
	port Execute : requires Execute
	port VariableExecute : provides VariableExecute
] {
	var myInt : integer := 3
	region main {
		initial Initial
		state _A
		state _B
		state _C
	}
	
	transition from Initial to _A
	transition from _A to _B when Execute.^execute / raise VariableExecute.^execute; myInt := _int + 2;
	transition from _B to _C when Execute.^execute / raise VariableExecute.^execute; _int := myInt + 4;
	
}