package default_arguments

import "Interfaces/Interfaces.gcd"

const H : integer := 100

@TransitionPriority = order-based
@RegionSchedule = bottom-up
statechart _3(i : integer := -50, b : boolean := true) [
	port Execute : requires Execute
] {
	var int_ : integer
	var int2 : integer
	var bool_ : boolean
	var bool2 : boolean
	
	region main {
		initial IMain
		state _0 {
			region a {
				initial IA
				state _1
				state _2
			}
		}
	}
	
	transition from IMain to _0
	transition from IA to _1
	transition from _1 to _2 when Execute.^execute /
		int_ := int_ + i;
		increment(int_);
		bool_ := bool_ xor b;
		bool2 := _and(bool_);
		useRecord();
		raise Execute.result;
		
	procedure increment(a : integer := -1000, b : integer := 100 * H + int_) : void {
		int2 := int_ + a + b;
	}
	
	lambda _and(a : boolean := false, b : boolean := true) : boolean := bool_ and a or b
	
	procedure useRecord(r : Record := #Record{ int_ := 19,  bool_ := true }) : void {
		int2 := r.int_ + int2;
		bool2 := r.bool_ xor bool2;
	}
	
}