package default_arguments

import "Interfaces/Interfaces.gcd"

@Asynchronous
@TransitionPriority = order-based
@RegionSchedule = bottom-up
statechart _6(c : CompositeArrayRecord :=
		#CompositeArrayRecord{ intArray := #[4, 3], arrayRecord := #ArrayRecord{ int_ := 33, boolArray := #[ true, true] } }) [
	port Execute : requires Execute
] {
	var int_ : integer
	var int2 : integer
	var bool_ : boolean
	var bool2 : boolean
	
	var intArray : [2]integer
	var boolArray : [2]boolean
	
	region main {
		initial IMain
		state _0 {
			region a {
				initial IA
				state _1
				state _2
			}
		}
	}
	
	transition from IMain to _0
	transition from IA to _1
	transition from _1 to _2 when Execute.^execute /
		int_ := int_ + c.intArray[1];
		int2 := int2 + c.intArray[0];
		bool2 := _and(c.arrayRecord.boolArray[1] xor bool_);
		useRecord();
		if (c.arrayRecord.boolArray[0]) {
			bool2 := c.arrayRecord.boolArray[1];
		}
		intArray := #[c.intArray[0], c.intArray[1]];
		boolArray := c.arrayRecord.boolArray;
		if (c.arrayRecord.boolArray[1] and select->boolean) {
			boolArray := #[boolArray[0] or c.arrayRecord.boolArray[1], boolArray[1] xor c.arrayRecord.boolArray[0]];
			intArray[0] := c.arrayRecord.int_ * c.intArray[1];
			intArray[1] := (((c.arrayRecord.boolArray[1]) ?
				c.arrayRecord.int_ * c.intArray[0] : -c.arrayRecord.int_ * c.intArray[1]
			) + select->#[-3 to 3)) mod 5;
		}
		raise Execute.result;
		
	lambda _and(a : boolean := c.arrayRecord.boolArray[1], b : boolean := true) : boolean := bool_ and a or b
	
	procedure useRecord(arrayRecord : ArrayRecord := #ArrayRecord{ int_ := 22, boolArray := #[ false, true] }) : void {
		bool_ := bool_ xor arrayRecord.boolArray[1];
		bool2 := bool2 xor arrayRecord.boolArray[0];
	}
	
}