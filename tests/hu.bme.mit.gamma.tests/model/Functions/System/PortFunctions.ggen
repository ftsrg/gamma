import "PortFunctionsSystem.gcd"
import "PortFunctionsSystem3.gcd"

analysis {
	component : PortFunctionsSystem
	language : IML
	state-coverage
}

verification {
	file : "PortFunctionsSystem.iml"
	language : Imandra
	property-file : ".PortFunctionsSystem.gpd"
	optimize-traces : true
}

analysis {
	component : PortFunctionsSystem3
	language : IML
	state-coverage
}

verification {
	file : "PortFunctionsSystem3.iml"
	language : Imandra
	property-file : ".PortFunctionsSystem3.gpd"
	optimize-traces : true
}