package functions

interface Execute {
	out event ^execute
}

interface FunctionExecute extends Execute {
	procedure setValue(x : integer) : void
	lambda getValue : integer
}

type Record : record {
	a : boolean,
	b : integer
}

type ComplexRecord : record {
	a : decimal,
	b : Record
}

type int : integer

type EnumTest : enum {
	_A, _B
}

type ArrayEnumRecord : record {
	a : [2]int,
	b : EnumTest
}