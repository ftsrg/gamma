package functions

interface Execute {
	out event ^execute
}

interface FunctionExecute extends Execute {
	procedure setValue(x : integer) : void
	lambda getValue : integer
	
	procedure setRecord(r : Rec0rd) : void
	lambda getRecord : Rec0rd
	
	procedure setComplexRecord(r : ComplexRecord) : void
	lambda getComplexRecord : ComplexRecord
	
	lambda factorial(value : integer) : integer := (value <= 1) ? 1 : value * factorial(value - 1)
}

type Rec0rd : record {
	a : boolean,
	b : integer
}

type ComplexRecord : record {
	a : decimal,
	b : Rec0rd
}

type int : integer

type EnumTest : enum {
	_A, _B
}

type ArrayEnumRecord : record {
	a : [2]int,
	b : EnumTest
}