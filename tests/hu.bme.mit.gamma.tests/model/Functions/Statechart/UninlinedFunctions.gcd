package nondetchoice

import "Interfaces/Interfaces.gcd"

statechart UninlinedFunctions [
	port Execute : requires Execute
] {
	var _complexRecord : ComplexRecord
	var _record : Record
	var _decimal : decimal
	var _int : integer
	var _bool : boolean
	region main {
		initial Initial
		state _A
		state _B
		state _C
		state _D
		state _E
		state _F
		state _G
		state _BB
		state _H
		state _I
		state _BBB
		state _J
		state _K
	}
	
	transition from Initial to _A
	transition from _A to _B when Execute.^execute / {
		var a : integer := _int;
		if (checkLambda(4.56)) {
			_int := factorialIfElse(5) + a;
			a := 2;
		}
		else {
			_int := factorialIfElse(4);
			a := 3;
		}
		_int := _int / a;
	}
	transition from _B to _C when Execute.^execute / _int := factorialIf(_int mod 4);
	transition from _C to _D when Execute.^execute / {
		var a : integer := _int mod 5;
		_int := factorialMerged(a);
	}
	transition from _D to _E when Execute.^execute / _int := factorialMerged(3);
	transition from _E to _F when Execute.^execute / _bool := checkLambda(1.2);
	transition from _F to _G when Execute.^execute / factorialLambda(-1); _int := factorialLambda(4);
	
	transition from _A to _BB when Execute.^execute_2 / addRecord(#Record{ b := -3, a := true });
	transition from _BB to _H when Execute.^execute / _int := addRecord(createRecord(11, false));
	transition from _H to _I when Execute.^execute / {
		_record := createRecord(67, true);
		addRecord(_record);
		_record.b := _record.b div 8;
	}
	
	transition from _A to _BBB when Execute.^execute_3 / addComplexRecord(#ComplexRecord{ a := 3.14, b := #Record{ a := false, b := 2 } });
	transition from _BBB to _J when Execute.^execute / _decimal := addComplexRecord(createComplexRecord(-1.2, 13, true));
	transition from _J to _K when Execute.^execute / {
		var _record : ComplexRecord := createComplexRecord(-2.1, -67, true);
		addComplexRecord(_record);
		_record.a := _record.a / -1.7;
		_record.b.b := _record.b.b mod 3;
	}
	
	lambda checkLambda(a : decimal) : boolean := _bool xor a >= -1.0
	
	lambda factorialLambda(val : integer) : integer := (val <= 1) ? 1 : val * factorialLambda(val - 1)
	
	procedure addRecord(rec : Record) : integer {
		_record.a := _record.a xor rec.a;
		choice {
			branch [rec.b < 10] {
				_record.b := _record.b mod rec.b;
			}
			branch [rec.b > 0] { // In test - one branch shall never be true
				_record.b := _record.b - rec.b;
			}
		}
		_bool := _record.a;
		return _record.b;
	}
	
	procedure addComplexRecord(rec : ComplexRecord) : decimal {
		_complexRecord.a := _complexRecord.a * rec.a;
		if (rec.b.b - 9 < 3 + 5) {
			var _temp : ComplexRecord := createComplexRecord(-2.743, 88, true);
			_temp.a := rec.a * 0.2;
			_complexRecord.a := _temp.a / rec.a;
		}
		_bool := _record.a or rec.b.a;
		return _complexRecord.a;
	}
	
	procedure factorialIfElse(value : integer) : integer {
		if (value <= 1) {
			return 1;
		}
		else {
			return value * factorialIfElse(value - 1);
		}
	}
	
	procedure factorialIf(value : integer) : integer {
		if (value <= 1) {
			return 1;
		}
		return value * factorialIf(value - 1);
	}
	
	procedure factorialMerged(value : integer) : integer {
		if (value <= 1) {
			return 1;
		}
		return value * factorialIfElse(value - 1);
	}
	
	procedure createRecord(b : integer, a : boolean) : Record {
		return #Record{ a := a, b := b };
	}
	
	procedure createComplexRecord(c : decimal, b : integer, a : boolean) : ComplexRecord {
		return #ComplexRecord{ a := c, b := createRecord(b, a) };
	}
	
}