package functions

import "Interfaces/Interfaces.gcd"

statechart Functions_4 [
	port Execute : requires Execute
] {
	var _record : ArrayEnumRecord
	var _int : integer
	region main {
		initial Initial
		state _A
		
		state _B
		state _C
		state _D
	}
	
	transition from Initial to _A
	transition from _A to _B when Execute.^execute /
			_record := createRecord(1, 2, EnumTest::_A);
			_int := handleRecord(_record);
	transition from _B to _C when Execute.^execute / {
			var _record : ArrayEnumRecord := createRecord(-1, -2, EnumTest::_B);
			_int := handleRecord(_record);
	}
	transition from _C to _D when Execute.^execute / {
			if (handleRecord(_record) < 100) {
				_int := _int * handleRecord(_record);
			}
	}
	
	procedure createRecord(a : int, b : int, c : EnumTest) : ArrayEnumRecord {
		return #ArrayEnumRecord {a := #[a, b], b := c};
	}

	procedure handleRecord(val : ArrayEnumRecord) : int {
		if (val.a[1] <= 0) {
			_record.a[0] := _record.a[1] + 2;
			return _record.a[0];
		}
		_record.a[1] := val.a[0];
		return val.a[1];
	}
	
}