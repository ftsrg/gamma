package functions

import "Interfaces/Interfaces.gcd"

statechart PortFunctions_1 [
	port Execute : requires Execute
	port FunctionExecute : provides FunctionExecute
] {
	var value : int := 1
	var rec : Record
	region main {
		initial Initial
		state _A
		
		state _B
		state _C
		state _D
	}
	
	transition from Initial to _A
	transition from _A to _B when Execute.^execute / {
		raise FunctionExecute.^execute;
		value := value + 1;
	}
	transition from _B to _C when Execute.^execute / raise FunctionExecute.^execute; rec.b := rec.b - 5;
	transition from _C to _D when Execute.^execute / raise FunctionExecute.^execute;
	
	procedure setValue(x : integer) : void { value := x; }
	lambda getValue : integer := value
	
	procedure setRecord(r : Record) : void { rec := r; }
	lambda getRecord : Record := rec
}