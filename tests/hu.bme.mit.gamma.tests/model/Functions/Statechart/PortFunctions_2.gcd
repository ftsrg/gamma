package functions

import "Interfaces/Interfaces.gcd"

statechart PortFunctions_2 [
	port FunctionExecute : requires FunctionExecute
] {
	var _int : integer := 2
	var _bool : boolean
	var rec : Record := #Record{a := true, b := 5}
	region main {
		initial Initial
		state _X
		
		state _Y
		state _Z
		state _A
	}
	
	transition from Initial to _X
	transition from _X to _Y when FunctionExecute.^execute / {
		var a : integer := _int;
		if (getValue() < 1000) {
			setValue(_int + 69);
			_bool := true;
		}
		_int := _int / a;
	}
	transition from _Y to _Z when FunctionExecute.^execute / _int := getValue(); setRecord(#Record{a := false, b := 10});
	transition from _Z to _A when FunctionExecute.^execute / _int := getValue(); rec := getRecord(); rec.b := rec.b + 1;
	
}