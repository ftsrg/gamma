package functions

import "Interfaces/Interfaces.gcd"

statechart PortFunctions_2 [
	port FunctionExecute : requires FunctionExecute
] {
	var _int : integer
	var _bool : boolean
	region main {
		initial Initial
		state _X
		
		state _Y
		state _Z
	}
	
	transition from Initial to _X
	transition from _X to _Y when FunctionExecute.^execute / {
		var a : integer := _int;
		if (getValue() < 1000) {
			setValue(_int);
			_bool := true;
		}
		_int := _int / a;
	}
	transition from _Y to _Z when FunctionExecute.^execute / _int := getValue();
	
}