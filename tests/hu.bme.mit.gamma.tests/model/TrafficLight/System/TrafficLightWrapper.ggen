import "TrafficLight/TrafficLight.gcd"
import "TrafficLightWrapper.gcd"

code {
	component : TrafficLightWrapper
	language : java
}

code {
	component : TrafficLight
	language : java
}

analysis {
	component : TrafficLightWrapper (1, true)
	file : "TrafficLightWrapper-XTA"
	language : XSTS-UPPAAL
	transition-coverage
}

analysis {
	component : TrafficLightWrapper (1, true)
	file : "TrafficLightWrapper-XSTS"
	language : Theta
	transition-coverage
}

analysis {
	component : TrafficLightWrapper (1, true)
	file : "TrafficLightWrapper-SMV"
	language : SMV
}

verification {
	language : XSTS-UPPAAL
	file : "TrafficLightWrapper-XTA.xml"
	property-file : ".TrafficLightWrapper-XTA.gpd"
	optimize : true
	test-language : java
}

verification {
	language : Theta
	file : "TrafficLightWrapper-XSTS.xsts"
	property-file : ".TrafficLightWrapper-XSTS.gpd"
	optimize : true
	test-language : java
}

verification {
	language : nuXmv
	file : "TrafficLightWrapper-SMV.smv"
	property-file : "TrafficLightWrapper-LTL.gpd"
	test-language : java
}