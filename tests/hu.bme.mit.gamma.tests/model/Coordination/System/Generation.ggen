analysis {
	component : CoordinationSeq
	language : XSTS
	folder : "model-gen-coordination-timed"
	optimize : false
	state-coverage
}

analysis {
	component : CoordinationSeq
	language : XSTS
	folder : "model-gen-coordination"
	optimize : false
	state-coverage
	constraint : {
		minimum-orchestrating-period : 0 s
		maximum-orchestrating-period : 4 s
	}
}

