package internal_transitions

import "Interfaces/Interfaces.gcd"

@TransitionPriority = order-based
@RegionSchedule = top-down
statechart _5 [
	port Execute : requires Execute
] {
	var id : integer
	var count : integer
	
	region main {
		initial IMain
		state A {
			internal when Execute.^execute [count < 3] / count := count + 1; id := 0;
			internal when Execute.^execute [count < 2] / count := count + 1; id := 4;
			region a {
				initial IA
				state B
				state C
			}
		}
		state D
	}
	
	transition from IMain to A
	transition from IA to B
	transition from B to B when Execute.^execute [count < 1] / count := count + 1; id := 1;
	transition from B to C when Execute.^execute [count >= 3] / id := 2; count := count + 1;
	
	transition from A to D when Execute.^execute [count >= 4] / id := 3;
}