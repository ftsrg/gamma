package select_expressions

import "Interfaces/Interfaces.gcd"

@TransitionPriority = order-based
@RegionSchedule = bottom-up
statechart _1 [
	port Execute : requires Execute
] {
	var selectBoolean : boolean
	var selectInteger : integer
//	var selectDecimal : decimal
	var selectIntegerArray : [2]integer
	
	var selectSubrange : integer
	var selectSubrange_1_100 : integer
	var selectSubrangeInteger_Inf__1 : integer
	var selectSubrangeInteger1_Inf : integer
	
	var selectEnum : Enumeration
	var selectRecord : Record
	var selectCompositeRecord : CompositeRecord
	
	region main {
		initial IMain
		state _0 {
			region a {
				initial IA
				state _1
				state _2
			}
		}
	}
	
	transition from IMain to _0
	transition from IA to _1
	transition from _1 to _2 when Execute.^execute /
		selectBoolean := select->boolean;
		selectInteger := select->integer;
//		selectDecimal := select->decimal;
		selectIntegerArray := select->[2]integer;
		
		selectSubrange := select->#[-infinity + 1 to infinity - 1);
		selectSubrange_1_100 := select->#[1 to 100);
		selectSubrangeInteger_Inf__1 := select->#[-infinity to -1);
		selectSubrangeInteger1_Inf := select->#[1 to infinity);
			
		selectEnum := select->Enumeration;
		selectRecord := select->Record;
		selectCompositeRecord := select->CompositeRecord;
	
}