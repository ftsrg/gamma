	optimize : true
	test-language : java
	optimize : true
	serialize-results : false
}

verification {
	language : Theta
	file : "TopDownComplexStatechart-XSTS.xsts"
	query-file : "TopDownComplexStatechart-XSTS.prop"
	test-language : java
	optimize : true
	serialize-results : false
}