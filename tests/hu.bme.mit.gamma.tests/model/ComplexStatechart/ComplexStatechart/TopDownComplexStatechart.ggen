import "ComplexStatechart/TopDownComplexStatechart.gcd"

code {
	component : TopDown
	language : java
}

analysis {
	component : TopDown
	language : UPPAAL
	file : "TopDownComplexStatechart-XTA"
	transition-coverage
}

analysis {
	component : TopDown
	language : Theta
	file : "TopDownComplexStatechart-XSTS"
	transition-coverage
}

verification {
	language : UPPAAL
	file : "TopDownComplexStatechart-XTA.xml"
